<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product - Inventory System</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <!-- Bootstrap Icons CSS -->
    <link rel="stylesheet" href="https://jsdelivr.net">
    <link rel="stylesheet" href="https://cloudflare.com">
</head>

<body class="bg-light">

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">
                <div class="card border-0 shadow-sm rounded-4">

                    <!-- Header Modal -->
                    <div class="card-header border-0 bg-white px-4 pt-4">
                        <h4 class="fw-bold mb-0">Edit Supplier</h4>
                        <p class="text-muted small mt-1">Perbarui informasi supplier Anda secara akurat.</p>
                    </div>

                    <!-- Body Modal -->
                    <div class="modal-body px-4 pb-4">
                        <form action="/update-supplier/<%= supplier.id %>" method="POST">
                            <div class="row g-4">
                                <!-- Kolom Kiri -->
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-muted">Supplier Name</label>
                                        <input type="text" name="name" value="<%= supplier.name %>"
                                            class="form-control bg-light border-0 py-2 shadow-sm"
                                            placeholder="e.g. Sumber Makmur" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-muted">Phone</label>
                                        <div class="input-group bg-light rounded-3 overflow-hidden shadow-sm">
                                            <input type="text" name="phone" value="<%= supplier.phone %>"
                                                class="form-control bg-light border-0 py-2 shadow-sm"
                                                placeholder="e.g. 0812345" required>
                                        </div>
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label fw-bold small text-muted">Location</label>
                                        <input type="text" name="location" value="<%= supplier.location %>"
                                            class="form-control bg-light border-0 py-2 shadow-sm"
                                            placeholder="e.g. SF-001" required>
                                    </div>
                                </div>

                                <!-- Kolom Kanan -->
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-muted">Email</label>
                                        <input type="email" name="email" value="<%= supplier.email %>"
                                            class="form-control bg-light border-0 py-2 shadow-sm"
                                            placeholder="e.g. Sumber@Makmur.com" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-muted">Industry</label>
                                        <select name="industry" class="form-select bg-light border-0 py-2 shadow-sm">
                                            <option value="">Pilih Industri</option>
                                            <option value="Electronics" <%=supplier.industry==='Electronics'
                                                ? 'selected' : '' %>>Electronics</option>
                                            <option value="Furniture" <%=supplier.industry==='Furniture' ? 'selected'
                                                : '' %>>Furniture</option>
                                            <option value="Logistics" <%=supplier.industry==='Logistics' ? 'selected'
                                                : '' %>>Logistics</option>
                                            <option value="Drink&Food" <%=supplier.industry==='Drink&Food' ? 'selected'
                                                : '' %>>Drink & Food</option>
                                            <option value="Konstruksi" <%=supplier.industry==='Konstruksi' ? 'selected'
                                                : '' %>>Konstruksi</option>
                                            <option value="Otomotif" <%=supplier.industry==='Otomotif' ? 'selected' : ''
                                                %>>Otomotif</option>
                                            <option value="Basic Materials" <%=supplier.industry==='Basic Materials'
                                                ? 'selected' : '' %>>Basic Materials</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="row g-2 mt-5">
                                <div class="col-md-6">
                                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow">
                                        <i class="bi bi-check-lg me-1"></i> Update Supplier
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <a href="/supplier"
                                        class="btn btn-light w-100 py-2 fw-bold rounded-3 text-secondary border shadow-sm text-center">
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>