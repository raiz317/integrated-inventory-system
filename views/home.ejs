<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InStockFlow - Master Your Inventory</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <!-- Bootstrap Icons CSS -->
    <link rel="stylesheet" href="https://jsdelivr.net">
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        * {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            /* Latar belakang gradasi halus sesuai gambar */
            background: radial-gradient(circle at top right, #d9e3f5, transparent 400px),
                radial-gradient(circle at top left, #b1c6ff, transparent 400px),
                #f4f7ff;
            min-height: 100vh;
        }

        /* Navbar Styling */
        .navbar-brand {
            font-weight: 800;
            letter-spacing: 1px;
        }

        .btn-outline-primary {
            border-radius: 8px;
            padding: 5px 20px;
        }

        /* Hero Section */
        .hero-section {
            padding: 80px 0 60px;
            text-align: center;
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 700;
            color: #1a1a1a;
        }

        .hero-subtitle {
            color: #666;
            margin-bottom: 30px;
        }

        .btn-request {
            background-color: #0d47a1;
            color: white;
            padding: 12px 30px;
            border-radius: 5px;
            font-weight: 500;
        }

        /* Feature Cards */
        .feature-card {
            border: none;
            border-radius: 20px;
            padding: 40px 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
            background: white;
            height: 100%;
        }

        .feature-card:hover {
            transform: translateY(-5px);
        }

        .icon-box {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 25px;
            font-size: 1.5rem;
            /* Ukuran Ikon */
        }

        .bg-blue-light {
            background-color: #e3f2fd;
            color: #1976d2;
        }

        .bg-orange-light {
            background-color: #fff3e0;
            color: #f57c00;
        }

        .bg-purple-light {
            background-color: #f3e5f5;
            color: #7b1fa2;
        }

        .card-title {
            font-weight: 700;
            font-size: 1.2rem;
        }

        .card-text {
            color: #777;
            font-size: 0.95rem;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-transparent pt-4">
        <div class="container">
            <a class="navbar-brand" href="#">InStockFlow</a>
            <div class="ms-auto d-flex align-items-center">
                <a class="nav-link me-4" href="/register">Register</a>
                <a class="btn btn-outline-primary" href="/login">Login</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero-section">
        <div class="container">
            <h1 class="hero-title mb-3">Mastering Our Inventory, Simply</h1>
            <p class="hero-subtitle fs-5">Effective control and seamless supplier integration</p>
        </div>
    </header>

    <!-- Features Section -->
    <section class="pb-5">
        <div class="container">
            <div class="row g-4">
                <!-- Card 1 -->
                <div class="col-md-4">
                    <div class="card feature-card">
                        <div class="icon-box bg-blue-light">
                            <img src="../icons/inves.png" alt="Real-Time Visibility"
                                style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                        <h5 class="card-title">Comprehensive Internal Asset & Data Overview</h5>
                        <p class="card-text">Gain complete visibility into the health of your operations. This dashboard
                            automatically calculates Total Products, Total Suppliers, and Total Asset Value, providing a
                            solid data foundation for all management decisions.
                        </p>
                    </div>
                </div>
                <!-- Card 2 -->
                <div class="col-md-4">
                    <div class="card feature-card">
                        <div class="icon-box bg-orange-light">
                            <img src="../icons/live.png" alt="Real-Time Visibility"
                                style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                        <h5 class="card-title">Critical Stock Monitoring & Real-Time Alerts</h5>
                        <p class="card-text">Ensure stock availability is maintained. The system automatically
                            identifies low-stock items and presents a list of products approaching the minimum level,
                            allowing the team to react quickly before operations are disrupted.</p>
                    </div>
                </div>
                <!-- Card 3 -->
                <div class="col-md-4">
                    <div class="card feature-card">
                        <div class="icon-box bg-purple-light">
                            <img src="../icons/suppliers.png" alt="Real-Time Visibility"
                                style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                        <h5 class="card-title">Seamless Product & Supplier Administration</h5>
                        <p class="card-text">Manage your internal database with an efficient system. Manage your product
                            directory and supplier database in a single, integrated platform to ensure data accuracy and
                            speed up operational administration.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>